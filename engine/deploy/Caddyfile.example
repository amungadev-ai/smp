# Drevanta Engine — bootstrap Caddyfile example.
# The engine normally POSTs its generated configuration to Caddy's admin API
# (127.0.0.1:2019). Use this file only to bootstrap before the first deploy.
{
	admin 127.0.0.1:2019
}

# Example site block created by the engine after a successful deploy:
# app.example.com {
# 	reverse_proxy 127.0.0.1:31234
# }
